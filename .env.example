# 1. Copy this file to ".env".  2. Fill in the two keys.  Never share or commit your .env.

# The game website. Its MCP server is at this address + /mcp
AGENCY_CUP_URL=https://agency.thisara.me

# Your team key: shown ONCE when you register your team on the game website
TEAM_KEY=ac_your_team_key

# Your NVIDIA key: free at https://build.nvidia.com (starts with nvapi-)
NVIDIA_API_KEY=nvapi-your-key

# Optional: pick a model from the approved list
# MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Optional: test with OpenAI instead of NVIDIA
# PROVIDER=openai
# OPENAI_API_KEY=sk-...
# MODEL=gpt-5.4-mini
